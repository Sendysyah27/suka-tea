class CashShift extends DataClass implements Insertable<CashShift> {
  final String id;
  final String outletId;
  final String? cashierId;
  final String cashierName;
  final String? closedByCashierId;
  final String closedByCashierName;
  final DateTime openedAt;
  final int openingFloat;
  final DateTime? closedAt;
  final int? countedCash;
  final int? expectedCash;
  final int? difference;
  final String status;
  final String note;
  const CashShift(
      {required this.id,
      required this.outletId,
      this.cashierId,
      required this.cashierName,
      this.closedByCashierId,
      required this.closedByCashierName,
      required this.openedAt,
      required this.openingFloat,
      this.closedAt,
      this.countedCash,
      this.expectedCash,
      this.difference,
      required this.status,
      required this.note});
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<String>(id);
    map['outlet_id'] = Variable<String>(outletId);
    if (!nullToAbsent || cashierId != null) {
      map['cashier_id'] = Variable<String>(cashierId);
    }
    map['cashier_name'] = Variable<String>(cashierName);
    if (!nullToAbsent || closedByCashierId != null) {
      map['closed_by_cashier_id'] = Variable<String>(closedByCashierId);
    }
    map['closed_by_cashier_name'] = Variable<String>(closedByCashierName);
    map['opened_at'] = Variable<DateTime>(openedAt);
    map['opening_float'] = Variable<int>(openingFloat);
    if (!nullToAbsent || closedAt != null) {
      map['closed_at'] = Variable<DateTime>(closedAt);
    }
    if (!nullToAbsent || countedCash != null) {
      map['counted_cash'] = Variable<int>(countedCash);
    }
    if (!nullToAbsent || expectedCash != null) {
      map['expected_cash'] = Variable<int>(expectedCash);
    }
    if (!nullToAbsent || difference != null) {
      map['difference'] = Variable<int>(difference);
    }
    map['status'] = Variable<String>(status);
    map['note'] = Variable<String>(note);
    return map;
  }

  CashShiftsCompanion toCompanion(bool nullToAbsent) {
    return CashShiftsCompanion(
      id: Value(id),
      outletId: Value(outletId),
      cashierId: cashierId == null && nullToAbsent
          ? const Value.absent()
          : Value(cashierId),
      cashierName: Value(cashierName),
      closedByCashierId: closedByCashierId == null && nullToAbsent
          ? const Value.absent()
          : Value(closedByCashierId),
      closedByCashierName: Value(closedByCashierName),
      openedAt: Value(openedAt),
      openingFloat: Value(openingFloat),
      closedAt: closedAt == null && nullToAbsent
          ? const Value.absent()
          : Value(closedAt),
      countedCash: countedCash == null && nullToAbsent
          ? const Value.absent()
          : Value(countedCash),
      expectedCash: expectedCash == null && nullToAbsent
          ? const Value.absent()
          : Value(expectedCash),
      difference: difference == null && nullToAbsent
          ? const Value.absent()
          : Value(difference),
      status: Value(status),
      note: Value(note),
    );
  }

  factory CashShift.fromJson(Map<String, dynamic> json,
      {ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return CashShift(
      id: serializer.fromJson<String>(json['id']),
      outletId: serializer.fromJson<String>(json['outletId']),
      cashierId: serializer.fromJson<String?>(json['cashierId']),
      cashierName: serializer.fromJson<String>(json['cashierName']),
      closedByCashierId:
          serializer.fromJson<String?>(json['closedByCashierId']),
      closedByCashierName:
          serializer.fromJson<String>(json['closedByCashierName']),
      openedAt: serializer.fromJson<DateTime>(json['openedAt']),
      openingFloat: serializer.fromJson<int>(json['openingFloat']),
      closedAt: serializer.fromJson<DateTime?>(json['closedAt']),
      countedCash: serializer.fromJson<int?>(json['countedCash']),
      expectedCash: serializer.fromJson<int?>(json['expectedCash']),
      difference: serializer.fromJson<int?>(json['difference']),
      status: serializer.fromJson<String>(json['status']),
      note: serializer.fromJson<String>(json['note']),
    );
  }
  @override
  Map<String, dynamic> toJson({ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return <String, dynamic>{
      'id': serializer.toJson<String>(id),
      'outletId': serializer.toJson<String>(outletId),
      'cashierId': serializer.toJson<String?>(cashierId),
      'cashierName': serializer.toJson<String>(cashierName),
      'closedByCashierId': serializer.toJson<String?>(closedByCashierId),
      'closedByCashierName': serializer.toJson<String>(closedByCashierName),
      'openedAt': serializer.toJson<DateTime>(openedAt),
      'openingFloat': serializer.toJson<int>(openingFloat),
      'closedAt': serializer.toJson<DateTime?>(closedAt),
      'countedCash': serializer.toJson<int?>(countedCash),
      'expectedCash': serializer.toJson<int?>(expectedCash),
      'difference': serializer.toJson<int?>(difference),
      'status': serializer.toJson<String>(status),
      'note': serializer.toJson<String>(note),
    };
  }

  CashShift copyWith(
          {String? id,
          String? outletId,
          Value<String?> cashierId = const Value.absent(),
          String? cashierName,
          Value<String?> closedByCashierId = const Value.absent(),
          String? closedByCashierName,
          DateTime? openedAt,
          int? openingFloat,
          Value<DateTime?> closedAt = const Value.absent(),
          Value<int?> countedCash = const Value.absent(),
          Value<int?> expectedCash = const Value.absent(),
          Value<int?> difference = const Value.absent(),
          String? status,
          String? note}) =>
      CashShift(
        id: id ?? this.id,
        outletId: outletId ?? this.outletId,
        cashierId: cashierId.present ? cashierId.value : this.cashierId,
        cashierName: cashierName ?? this.cashierName,
        closedByCashierId: closedByCashierId.present
            ? closedByCashierId.value
            : this.closedByCashierId,
        closedByCashierName: closedByCashierName ?? this.closedByCashierName,
        openedAt: openedAt ?? this.openedAt,
        openingFloat: openingFloat ?? this.openingFloat,
        closedAt: closedAt.present ? closedAt.value : this.closedAt,
        countedCash: countedCash.present ? countedCash.value : this.countedCash,
        expectedCash:
            expectedCash.present ? expectedCash.value : this.expectedCash,
        difference: difference.present ? difference.value : this.difference,
        status: status ?? this.status,
        note: note ?? this.note,
      );
  CashShift copyWithCompanion(CashShiftsCompanion data) {
    return CashShift(
      id: data.id.present ? data.id.value : this.id,
      outletId: data.outletId.present ? data.outletId.value : this.outletId,
      cashierId: data.cashierId.present ? data.cashierId.value : this.cashierId,
      cashierName:
          data.cashierName.present ? data.cashierName.value : this.cashierName,
      closedByCashierId: data.closedByCashierId.present
          ? data.closedByCashierId.value
          : this.closedByCashierId,
      closedByCashierName: data.closedByCashierName.present
          ? data.closedByCashierName.value
          : this.closedByCashierName,
      openedAt: data.openedAt.present ? data.openedAt.value : this.openedAt,
      openingFloat: data.openingFloat.present
          ? data.openingFloat.value
          : this.openingFloat,
      closedAt: data.closedAt.present ? data.closedAt.value : this.closedAt,
      countedCash:
          data.countedCash.present ? data.countedCash.value : this.countedCash,
      expectedCash: data.expectedCash.present
          ? data.expectedCash.value
          : this.expectedCash,
      difference:
          data.difference.present ? data.difference.value : this.difference,
      status: data.status.present ? data.status.value : this.status,
      note: data.note.present ? data.note.value : this.note,
    );
  }

  @override
  String toString() {
    return (StringBuffer('CashShift(')
          ..write('id: $id, ')
          ..write('outletId: $outletId, ')
          ..write('cashierId: $cashierId, ')
          ..write('cashierName: $cashierName, ')
          ..write('closedByCashierId: $closedByCashierId, ')
          ..write('closedByCashierName: $closedByCashierName, ')
          ..write('openedAt: $openedAt, ')
          ..write('openingFloat: $openingFloat, ')
          ..write('closedAt: $closedAt, ')
          ..write('countedCash: $countedCash, ')
          ..write('expectedCash: $expectedCash, ')
          ..write('difference: $difference, ')
          ..write('status: $status, ')
          ..write('note: $note')
          ..write(')'))
        .toString();
  }

  @override
  int get hashCode => Object.hash(
      id,
      outletId,
      cashierId,
      cashierName,
      closedByCashierId,
      closedByCashierName,
      openedAt,
      openingFloat,
      closedAt,
      countedCash,
      expectedCash,
      difference,
      status,
      note);
  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      (other is CashShift &&
          other.id == this.id &&
          other.outletId == this.outletId &&
          other.cashierId == this.cashierId &&
          other.cashierName == this.cashierName &&
          other.closedByCashierId == this.closedByCashierId &&
          other.closedByCashierName == this.closedByCashierName &&
          other.openedAt == this.openedAt &&
          other.openingFloat == this.openingFloat &&
          other.closedAt == this.closedAt &&
          other.countedCash == this.countedCash &&
          other.expectedCash == this.expectedCash &&
          other.difference == this.difference &&
          other.status == this.status &&
          other.note == this.note);
}

