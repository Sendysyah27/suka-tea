      Value<String>? note,
      Value<int>? rowid}) {
    return CashShiftsCompanion(
      id: id ?? this.id,
      outletId: outletId ?? this.outletId,
      cashierId: cashierId ?? this.cashierId,
      cashierName: cashierName ?? this.cashierName,
