# Salin ke .env dan isi dari dashboard Supabase (proyek dev/prod terpisah).
# JANGAN commit file .env. Jangan tulis URL/key asli di repo mana pun.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Sheets export (diisi di secret Edge Function, BUKAN di app):
# GOOGLE_SERVICE_ACCOUNT_JSON=... (via `supabase secrets set`, jangan di repo)
